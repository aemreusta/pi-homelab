# mac-worker/github-runner/.env — supervisor configuration.
# Copy to .env (gitignored) and fill in. The PAT lives ONLY here, only on the
# Mac, and is mounted ONLY into the supervisor container (never a job container).
# See docs/design/039-mac-ci-runner.md "Security boundary".

# GitHub owner of both repos.
GH_OWNER=aemreusta

# Comma-separated repos the supervisor serves (repo-level JIT runners).
GH_REPOS=raspi-homelab,my-image-repo

# Fine-grained PAT — scope: these two repos, Repository permissions →
# Administration: read+write (the minimum to mint repo-level JIT configs).
# MANDATORY expiry 90–180d; rotate per the runbook. NEVER commit a real value.
GITHUB_PAT=github_pat_CHANGE_ME

# Pinned images (built once, pushed to Zot — see 039 Setup step 3).
RUNNER_IMAGE=raspberrypi.local:5050/homelab/github-runner:CHANGE_ME

# Runner labels — uniform across both repos (GitHub default casing).
RUNNER_LABELS=self-hosted,linux,ARM64,homelab-build

# Concurrency (039 "Concurrency model"). Raised 1→2 (2026-07-03) so a slow
# image build and a fast raspi-homelab CI run don't head-of-line
# block each other. 2 is the ceiling — the Mac thrashes running two heavy
# arm64 image builds at once; scale the queue at the source (workflow
# cancel-in-progress) rather than going higher.
MAX_CONCURRENT_GLOBAL=2
IDLE_RUNNERS_PER_REPO=1

# How often the supervisor reconciles + emits heartbeat (seconds).
POLL_INTERVAL=60

# Reap GitHub runner registrations that have been offline longer than this (s).
ORPHAN_REAP_SECONDS=900

# NFS-mounted dir the Pi reads (heartbeat + status.json go under gh-runner/).
NFS_GENERATED_DIR=/generated
