# Fluent Bit config — managed by Ansible.
# Tails Docker container json log files, enriches with host + container_id,
# ships to VictoriaLogs over the /insert/jsonline endpoint.

[SERVICE]
    Flush         5
    Daemon        Off
    Log_Level     info
    Parsers_File  parsers.conf
    HTTP_Server   On
    HTTP_Listen   0.0.0.0
    HTTP_Port     2020
    # Filesystem buffer enables storage.type filesystem on pipeline-events tail.
    # Reviewed 2026-05-14: fluentbit_pipeline_buffer_dir maps to a host bind
    # mount (fluentbit_data_dir → /data in docker-compose.yml.j2), so the
    # buffer persists across container recreation — not the writable layer.
    storage.path              {{ fluentbit_pipeline_buffer_dir }}
    storage.sync              normal
    storage.backlog.mem_limit 32M

[INPUT]
    Name              tail
    Path              {{ fluentbit_tail_path }}
    Path_Key          log_path
    Parser            docker
    Tag               docker.*
    Refresh_Interval  5
    Mem_Buf_Limit     {{ fluentbit_mem_buf_limit }}
    Skip_Long_Lines   On
    DB                {{ fluentbit_db_path }}
    Read_From_Head    False

# Media pipeline structured events. pl_event from pipeline-lib.sh
# writes one JSON object per line. storage.type filesystem buffers events
# to disk so a VictoriaLogs restart does NOT drop pipeline events.
[INPUT]
    Name              tail
    Path              {{ fluentbit_pipeline_log_path }}
    Path_Key          log_path
    Parser            pipeline_event
    Tag               pipeline.*
    Refresh_Interval  5
    Mem_Buf_Limit     {{ fluentbit_mem_buf_limit }}
    Skip_Long_Lines   On
    DB                {{ fluentbit_pipeline_db_path }}
    Read_From_Head    False
    storage.type      filesystem

# Drop known-benign upstream log noise before it reaches VictoriaLogs.
# Patterns live in fluentbit_docker_exclude_patterns (defaults/main.yml).
{# Docs: docs/runbooks/020-known-log-noise.md — inclusion criteria, per-entry
   rationale, verification evidence, baseline volume and audit cadence. #}
[FILTER]
    Name    grep
    Match   docker.*
{% for pattern in fluentbit_docker_exclude_patterns %}
    Exclude log /{{ pattern }}/
{% endfor %}

# Add static labels to every record (host, env, etc.)
[FILTER]
    Name    record_modifier
    Match   docker.*
{% for k, v in fluentbit_labels.items() %}
    Record  {{ k }} {{ v }}
{% endfor %}

# Same static labels for pipeline.* events (host=homelab) so VL stream
# identity includes host. pipeline + step fields come from the JSON itself.
[FILTER]
    Name    record_modifier
    Match   pipeline.*
{% for k, v in fluentbit_labels.items() %}
    Record  {{ k }} {{ v }}
{% endfor %}

# Lua filter — extracts container_id from log_path, looks up container_name
# from the sibling config.v2.json (cached per container), and pulls a coarse
# log_level token out of bracketed level markers in the message body.
# Source: roles/fluentbit/templates/enrich.lua.j2
[FILTER]
    Name    lua
    Match   docker.*
    script  /fluent-bit/etc/enrich.lua
    call    enrich

# Docker container logs → VL stream keyed by host+container_id.
[OUTPUT]
    Name             http
    Match            docker.*
    Host             {{ fluentbit_vl_host }}
    Port             {{ fluentbit_vl_port }}
    URI              /insert/jsonline?_stream_fields={{ fluentbit_stream_fields }}&_msg_field={{ fluentbit_msg_field }}&_time_field={{ fluentbit_time_field }}
    Format           json_lines
    json_date_format iso8601
    compress         gzip
    Retry_Limit      10

# Pipeline events → VL stream keyed by host+pipeline+step (bounded enum).
# No _msg_field: the JSON IS the message; LogsQL queries fields directly.
[OUTPUT]
    Name             http
    Match            pipeline.*
    Host             {{ fluentbit_vl_host }}
    Port             {{ fluentbit_vl_port }}
    URI              /insert/jsonline?_stream_fields={{ fluentbit_pipeline_stream_fields }}&_time_field={{ fluentbit_pipeline_time_field }}
    Format           json_lines
    json_date_format iso8601
    compress         gzip
    Retry_Limit      10
