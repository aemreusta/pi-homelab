#!/usr/bin/env python3
"""ntfy-bridge.py — Alertmanager webhook receiver.

Receives Alertmanager webhook POSTs at /, parses the alert payload, sends
one ntfy notification per alert (firing or resolved), and appends a
structured logfmt line to /var/log/alert-audit.log so vmalert-fired
alerts share the same audit trail as the host-side cron scripts. Closes
G-F (notification-delivery proof) from Sprint 18 plan.

Audit format (matches alert-lib.sh convention):
    <ISO8601> script=vmalert step=alert status=<firing|resolved> \\
        alertname=<...> severity=<...> service=<...> http=<ntfy_code>

Zero deps — uses only stdlib. Runs in python:3.13-alpine.

Managed by Ansible (alertmanager role) — do not edit manually.
"""
from __future__ import annotations

import base64
import json
import os
import sys
import threading
import time
import urllib.request
import urllib.error
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

NTFY_URL = os.environ.get("NTFY_URL", "{{ ntfy_external_topic_url }}")
AUDIT_LOG = os.environ.get("AUDIT_LOG", "/var/log/alert-audit.log")
LISTEN_PORT = int(os.environ.get("LISTEN_PORT", "{{ alertmanager_bridge_port }}"))

# Map vmalert severity label to ntfy Priority header.
SEVERITY_TO_PRIORITY = {
    "crit": "urgent",
    "warn": "high",
    "info": "default",
}
SEVERITY_TO_TAGS = {
    "crit": "rotating_light",
    "warn": "warning",
    "info": "information_source",
}

# Backoff between ntfy POST attempts, in seconds. One extra attempt runs
# after the final delay, so this is 6 attempts spanning ~62 s.
#
# Sized to the AdGuard startup window: after a reboot the bridge is up before
# DNS is, and `ntfy.example.internal` is unresolvable for roughly a minute.
# The previous single 2 s retry could not span it, so every alert fired in
# that window was lost (10 in 24 h, 2026-08-02). Kept bounded because
# Alertmanager's retry is the real outer loop — this only smooths the common
# short case so AM does not have to churn.
RETRY_BACKOFF_SECONDS = (2, 4, 8, 16, 32)

# Delivery-health counters, exposed at /metrics. ThreadingHTTPServer means
# concurrent handlers, so mutation is lock-guarded.
SEND_FAILURES = 0
ALERTS_TOTAL = 0
_COUNTER_LOCK = threading.Lock()


def audit(status: str, **fields: str) -> None:
    """Append one logfmt line to AUDIT_LOG. Logger fallback on EPERM."""
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    kv = " ".join(f"{k}={v}" for k, v in fields.items() if v is not None)
    line = f"{ts} script=vmalert step=alert status={status} {kv}\n"
    try:
        with open(AUDIT_LOG, "a", encoding="utf-8") as f:
            f.write(line)
    except OSError as e:
        # Fall back to stderr — Docker JSON logs preserve it.
        print(f"audit-log unwritable ({e}): {line}", end="", file=sys.stderr)


def header_safe(value: str) -> str:
    """RFC 2047-encode a header value unless it is latin-1-safe.

    Python's http.client encodes HTTP headers as latin-1 and raises
    UnicodeEncodeError on anything outside it — an em-dash (U+2014) in an
    alert summary crashed the handler thread mid-send, so the notification
    was never delivered AND no audit line was written (silent-delivery
    class, 2026-07-16). ntfy explicitly supports RFC 2047 encoded words
    in any header ("not every library supports UTF-8 headers").
    """
    try:
        value.encode("latin-1")
        return value
    except UnicodeEncodeError:
        b64 = base64.b64encode(value.encode("utf-8")).decode("ascii")
        return f"=?UTF-8?B?{b64}?="


def send_ntfy(title: str, body: str, priority: str, tags: str) -> int:
    """Send one ntfy POST. Returns HTTP code (0 on transport error).

    Retries transport errors on an exponential backoff spanning ~62 s.

    The schedule is sized to a MEASURED outage, not an imagined one. It used
    to be a single retry after 2 s, scoped by its own comment to "Docker's
    embedded DNS transiently". The real failure (2026-08-02, 10 losses in
    24 h) is the ~60 s AdGuard needs to start after a reboot, during which
    `ntfy.example.internal` does not resolve at all. A 2 s retry cannot span
    that, so every alert fired in the post-boot window was dropped — and
    those are the alerts most worth delivering.

    Bounded on purpose: Alertmanager's own retry is the outer loop (see
    process_payload). An unbounded retry here would pin the handler thread
    and stall every later alert behind a dead ntfy.

    HTTPError returns immediately without retrying — a 4xx/5xx is a real
    answer from a reachable ntfy, so retrying only duplicates a definitive
    result. Only transport failures (DNS, refused, timeout) are transient.

    Never raises: a crash here would skip the audit line and make the
    failure invisible, which is how silent-delivery #2 shipped.
    """
    global SEND_FAILURES
    req = urllib.request.Request(
        NTFY_URL,
        data=body.encode("utf-8"),
        headers={
            "Title": header_safe(title),
            "Priority": priority,
            "Tags": tags,
            "Markdown": "yes",
        },
        method="POST",
    )
    last_err: Exception | None = None
    for delay in (*RETRY_BACKOFF_SECONDS, None):
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                return resp.status
        except urllib.error.HTTPError as e:
            return e.code
        except Exception as e:  # URLError/TimeoutError + encode surprises
            last_err = e
            if delay is not None:
                time.sleep(delay)
    with _COUNTER_LOCK:
        SEND_FAILURES += 1
    print(f"ntfy POST failed after {len(RETRY_BACKOFF_SECONDS) + 1} attempts: "
          f"{last_err}", file=sys.stderr)
    return 0


def render_metrics() -> str:
    """Prometheus exposition for the bridge's own delivery health.

    Until now a failed send existed only as a line on container stderr,
    which nothing scrapes — so silent-delivery #3 was invisible for 24 h
    despite the stack being otherwise fully instrumented. Emitting the
    counter is half the fix; the vmalert rule reading it is the other half
    (pinned by tests/test_ntfy_bridge.py).
    """
    return (
        "# HELP ntfy_bridge_send_failures_total ntfy POSTs that exhausted "
        "every retry.\n"
        "# TYPE ntfy_bridge_send_failures_total counter\n"
        f"ntfy_bridge_send_failures_total {SEND_FAILURES}\n"
        "# HELP ntfy_bridge_alerts_total Alerts processed by the bridge.\n"
        "# TYPE ntfy_bridge_alerts_total counter\n"
        f"ntfy_bridge_alerts_total {ALERTS_TOTAL}\n"
    )


def process_payload(payload: dict) -> bool:
    """Handle every alert in one Alertmanager webhook payload.

    Returns True only if EVERY send succeeded. The caller maps that to the
    HTTP status, which is the whole point:

    `do_POST` used to answer 204 unconditionally — including when the ntfy
    send had just failed. Alertmanager was told "delivered", so it never
    retried, and a transient DNS blip became permanent alert loss. Answering
    5xx hands the retry back to Alertmanager, which already backs off over
    minutes rather than the seconds we could justify holding a thread for.

    A partial failure counts as failure. AM re-sends the whole group, so an
    alert that did succeed may be delivered twice — a duplicate notification
    is recoverable, a dropped one is not.
    """
    group_status = payload.get("status", "firing")
    ok = True
    for alert in payload.get("alerts", []):
        if not handle_alert(alert, group_status):
            ok = False
    return ok


def alert_age(alert: dict, status: str) -> tuple[str, bool]:
    """Add context to repeats without changing routing, severity or delivery."""
    try:
        start = datetime.fromisoformat(alert["startsAt"].replace("Z", "+00:00"))
        end = (datetime.fromisoformat(alert["endsAt"].replace("Z", "+00:00"))
               if status == "resolved" else datetime.fromtimestamp(time.time(), timezone.utc))
        if start.tzinfo is None or end.tzinfo is None:
            return "", False
        seconds = int((end - start).total_seconds())
        if seconds < 0 or start.year < 2000:
            return "", False
        minutes = seconds // 60
        duration = (f"{minutes // 1440}d {(minutes % 1440) // 60}h" if minutes >= 1440
                    else f"{minutes // 60}h {minutes % 60}m")
        prefix = "Duration:" if status == "resolved" else "Active for"
        return f"{prefix} {duration}\n\n", seconds >= 86400
    except (KeyError, TypeError, ValueError, AttributeError, OverflowError):
        return "", False


def handle_alert(alert: dict, group_status: str) -> bool:
    """Process one alert from the AM webhook payload.

    Returns True if ntfy accepted it. The return value is what lets
    process_payload tell Alertmanager the truth about delivery.
    """
    global ALERTS_TOTAL
    with _COUNTER_LOCK:
        ALERTS_TOTAL += 1
    status = alert.get("status", group_status)  # firing | resolved
    labels = alert.get("labels", {})
    annots = alert.get("annotations", {})

    alertname = labels.get("alertname", "unknown")
    severity = labels.get("severity", "info")
    service = labels.get("service", "")

    summary = annots.get("summary", alertname)
    description = annots.get("description", "")
    age, ongoing = alert_age(alert, status)
    description = age + description

    if status == "resolved":
        title = f"[RESOLVED] {summary}"
        priority = "low"
        tags = "white_check_mark"
    else:
        title = f"[ONGOING] {summary}" if ongoing else summary
        priority = SEVERITY_TO_PRIORITY.get(severity, "default")
        tags = SEVERITY_TO_TAGS.get(severity, "loud_sound")

    http_code = send_ntfy(title, description, priority, tags)
    delivered = 200 <= http_code < 300
    audit(
        status="ok" if delivered else "fail",
        alertname=alertname,
        severity=severity,
        service=service or "host",
        firing=status,
        http=str(http_code),
    )
    return delivered


class Handler(BaseHTTPRequestHandler):
    def do_POST(self) -> None:  # noqa: N802 — BaseHTTPRequestHandler API
        length = int(self.headers.get("Content-Length", "0"))
        body = self.rfile.read(length) if length else b"{}"
        try:
            payload = json.loads(body)
        except json.JSONDecodeError:
            self.send_response(400)
            self.end_headers()
            return
        # 204 only if ntfy actually took it. Answering 204 unconditionally
        # told Alertmanager "delivered" even when the send had failed, so AM
        # never retried and a transient DNS blip became permanent alert loss
        # (2026-08-02). 500 hands the retry back to AM, which backs off over
        # minutes — far longer than we can justify holding this thread.
        if process_payload(payload):
            self.send_response(204)
        else:
            self.send_response(500)
        self.end_headers()

    def do_GET(self) -> None:  # noqa: N802
        """Healthcheck + delivery-health metrics."""
        if self.path == "/metrics":
            payload = render_metrics().encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; version=0.0.4")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
        elif self.path in ("/healthz", "/health", "/"):
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"ok\n")
        else:
            self.send_response(404)
            self.end_headers()

    # Quieter access log — Alertmanager retries on 5xx so we don't need
    # per-request lines unless we're debugging.
    def log_message(self, fmt: str, *args: object) -> None:
        return


def main() -> int:
    server = ThreadingHTTPServer(("", LISTEN_PORT), Handler)
    print(f"ntfy-bridge listening on :{LISTEN_PORT} → {NTFY_URL}", file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        server.shutdown()
    return 0


if __name__ == "__main__":
    sys.exit(main())
