groups:
  - name: beszel-data
    interval: 1m
    rules:
      - alert: BeszelSamplesStale
        expr: |
          time() - beszel_last_sample_timestamp_seconds > 900
          or absent(beszel_last_sample_timestamp_seconds)
        for: 10m
        labels:
          severity: warn
          source: vmalert
        annotations:
          summary: "Beszel has no recent agent samples"
          description: "The expected system has no raw sample newer than 15 minutes. A healthy hub endpoint does not prove collection is working. Check the Beszel agent connection and system status; do not reset the historical database."

      - alert: BeszelFreshnessCollectorFailed
        expr: |
          beszel_freshness_success == 0
          or time() - beszel_freshness_last_run_timestamp_seconds > 900
          or absent(beszel_freshness_success)
        for: 10m
        labels:
          severity: warn
          source: vmalert
        annotations:
          summary: "Beszel sample freshness cannot be verified"
          description: "The independent read-only database check failed or missed its schedule. Check cron and /usr/local/bin/beszel-freshness.py; missing data is not a healthy agent."
