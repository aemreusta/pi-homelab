def _is_inside_srv(path, srv_real=None):
    """True iff realpath(path) is strictly inside /srv (resolved).

    Uses commonpath equality rather than prefix matching so crafted paths
    like '/srv_evil/...' or '/srv' itself cannot slip past.
    """
    base = srv_real or os.path.realpath("/srv")
    try:
        real = os.path.realpath(path)
    except (OSError, ValueError):
        return False
    try:
        return os.path.commonpath([real, base]) == base and real != base
    except ValueError:
        return False


def _is_safe_compose_dir(path):
    """True iff a COMPOSE_DIRS entry is a real directory under the docker
    root and contains no symlink hops on the way in.

    This blocks an attacker who can drop a symlink at one of the compose
    paths pointing at their own docker-compose.yml to achieve RCE via
    the /update endpoint.
    """
    docker_root = os.path.realpath("/home/{{ docker_user }}/docker")
    try:
        real = os.path.realpath(path)
    except (OSError, ValueError):
        return False
    if not os.path.isdir(real) or os.path.islink(path):
        return False
    try:
        return os.path.commonpath([real, docker_root]) == docker_root
    except ValueError:
        return False


def ntfy(title, message, priority="default", tags="", actions=""):
    """Send a notification to ntfy. Fire-and-forget, never raises.

    Always sends Markdown: yes so multi-line bodies render with real
    line breaks (and **bold** etc.) on the mobile app.
    """
    try:
        import urllib.request  # noqa: PLC0415

        headers = {
            "Title": title,
            "Priority": priority,
            "Markdown": "yes",
        }
        if tags:
            headers["Tags"] = tags
        if actions:
            headers["Actions"] = actions
        req = urllib.request.Request(  # noqa: S310
            NTFY_URL, data=message.encode(), headers=headers, method="POST",
        )
        urllib.request.urlopen(req, timeout=5)  # noqa: S310
    except Exception:
        pass  # best-effort — never break the action


STORAGE_CACHE_TTL = 60  # seconds
_STORAGE_CACHE = {"data": None, "ts": 0.0, "refreshing": False, "last_error": None}
_STORAGE_CACHE_LOCK = threading.Lock()

# Backing filesystems to report separately. /srv spans more than one spindle
# since design 042 (parts of it are bind mounts from the second SSD), so a
# single total is misleading. Entries whose path is not actually a mountpoint
# are skipped, which is what makes this degrade quietly when ssd2 has dropped
# off the USB bus rather than reporting the root disk's numbers under its name.
STORAGE_FILESYSTEMS = [
    ("root SSD", "/"),
    ("ssd2 (Kingston)", "{{ storage_ssd2_mount | default('/mnt/ssd2') }}"),
]

# Directories that live OUTSIDE /srv but whose bytes are on the root disk and
# which the operator needs to see: `_dir_size` correctly refuses to descend
# into a filesystem mounted under /srv, so a tree whose bytes live elsewhere
# on this disk is listed explicitly — a panel that shows neither number is
# worse than one that shows a wrong one.
EXTRA_SIZE_DIRS = {{ homelab_control_extra_size_dirs | default([]) | to_json }}


def get_backup_status():
    """Read the backup state file + tail the structured log.

    Returns whatever is on disk; if the state file is missing the response
    is shaped like a "never run" marker so the panel doesn't crash. The
    log tail is a *separate* signal from the state — it shows in-flight
    runs the state file hasn't been overwritten with yet.
    """
    state = {"last_run_ts": None, "status": "never_run", "per_service": {}}
    try:
        with open(BACKUP_STATE_FILE) as f:
            state = json.load(f)
    except (OSError, json.JSONDecodeError):
        pass

    recent_log = []
    try:
        # Tail the last N lines; the log is JSONL so each line is one event.
        with open(BACKUP_LOG_FILE) as f:
            lines = f.readlines()[-BACKUP_LOG_TAIL_LINES:]
        for line in lines:
            try:
                recent_log.append(json.loads(line))
            except json.JSONDecodeError:
                recent_log.append({"raw": line.strip()})
    except OSError:
        pass

    return {"state": state, "recent_log": recent_log}


def _dir_size(path):
    """Bytes under `path`, NOT crossing filesystem boundaries (`du -x`).

    The device check is load-bearing, not tidiness. A FUSE/remote
    filesystem mounted under /srv (e.g. a cloud mount) would otherwise:

      * count REMOTE bytes as local disk usage, contradicting the
        df-derived figures alongside it; and
      * traverse FUSE, issuing remote API calls on every dir-cache miss.

    `du -xsh` is already the documented way to measure this box;
    this makes the API agree with the CLI.
    """
    total = 0
    try:
        root_dev = os.stat(path).st_dev
    except OSError:
        return 0
    try:
        for dirpath, dirs, files in os.walk(path):
            # Prune other filesystems before descending into them.
            dirs[:] = [
                d for d in dirs
                if _same_device(os.path.join(dirpath, d), root_dev)
            ]
            for fname in files:
                try:
                    st = os.lstat(os.path.join(dirpath, fname))
                    if st.st_dev != root_dev:
                        continue
                    total += st.st_size
                except OSError:
                    pass
    except OSError:
        pass
    return total


def _same_device(path, root_dev):
    try:
        return os.stat(path).st_dev == root_dev
    except OSError:
        return False


def _refresh_storage_stats():
    """Exactly one background scan; preserve the previous snapshot on failure."""
    try:
        result = _measure_storage_stats()
    except Exception as exc:
        result = {"error": str(exc)}
    with _STORAGE_CACHE_LOCK:
        if "error" not in result:
            _STORAGE_CACHE["data"] = result
        _STORAGE_CACHE["last_error"] = result.get("error")
        # TTL starts when the scan FINISHES, including failed attempts.
        _STORAGE_CACHE["ts"] = time.monotonic()
        _STORAGE_CACHE["refreshing"] = False


def get_storage_stats():
    """Return the last snapshot immediately while one worker refreshes it."""
    with _STORAGE_CACHE_LOCK:
        cached = _STORAGE_CACHE["data"]
        fresh = (cached is not None or _STORAGE_CACHE["last_error"] is not None) and (
            time.monotonic() - _STORAGE_CACHE["ts"] < STORAGE_CACHE_TTL
        )
        if not fresh and not _STORAGE_CACHE["refreshing"]:
            _STORAGE_CACHE["refreshing"] = True
            try:
                threading.Thread(target=_refresh_storage_stats, daemon=True).start()
            except Exception:
                _STORAGE_CACHE["refreshing"] = False
                raise
        extra = {
            "cached": cached is not None,
            "refreshing": _STORAGE_CACHE["refreshing"],
            "scan_error": _STORAGE_CACHE["last_error"],
        }
        if cached is not None:
            return {**cached, **extra}
    # Cold start exposes capacity immediately, without walking a directory.
    try:
        usage = shutil.disk_usage("/srv")
        return {
            "total_bytes": usage.total, "used_bytes": usage.used,
            "free_bytes": usage.free,
            "use_percent": round(usage.used / usage.total * 100, 1) if usage.total else 0,
            "filesystems": [], "dirs": [], "scan_time": None, **extra,
        }
    except OSError as exc:
        return {"error": str(exc), **extra}


def _measure_storage_stats():
    """Measure in a background worker; keep archive filesystem boundaries."""
    try:
        usage = shutil.disk_usage("/srv")
        total, used, free = usage.total, usage.used, usage.free

        subdirs = [
            entry for entry in os.scandir("/srv")
            if entry.is_dir(follow_symlinks=False)
        ]
        dir_sizes = []
        if subdirs:
            with concurrent.futures.ThreadPoolExecutor(
                max_workers=min(2, len(subdirs)),
            ) as pool:
                sizes = list(pool.map(lambda e: _dir_size(e.path), subdirs))
            for entry, size in zip(subdirs, sizes):
                dir_sizes.append({
                    "name": entry.name,
                    "path": entry.path,
                    "bytes": size,
                })
        for extra in EXTRA_SIZE_DIRS:
            epath = extra.get("path", "")
            if not epath or not os.path.isdir(epath):
                continue
            dir_sizes.append({
                "name": extra.get("name") or epath,
                "path": epath,
                "bytes": _dir_size(epath),
            })

        dir_sizes.sort(key=lambda x: x["bytes"], reverse=True)

        # /srv is no longer one spindle. Since 2026-08-02 some of it is bind
        # mounted from the second SSD (design 042), so the totals above — which
        # describe whichever filesystem backs /srv itself — silently understate
        # capacity and misattribute free space. Report each backing filesystem
        # separately so the panel can't imply a subdirectory's bytes came out
        # of the root disk's budget.
        filesystems = []
        for label, path in STORAGE_FILESYSTEMS:
            try:
                if not os.path.ismount(path) and path != "/srv":
                    continue
                fs = shutil.disk_usage(path)
            except OSError:
                continue
            filesystems.append({
                "label": label,
                "path": path,
                "total_bytes": fs.total,
                "used_bytes": fs.used,
                "free_bytes": fs.free,
                "use_percent": round(fs.used / fs.total * 100, 1) if fs.total else 0,
            })

        result = {
            "total_bytes": total,
            "used_bytes": used,
            "free_bytes": free,
            "use_percent": round(used / total * 100, 1) if total else 0,
            "filesystems": filesystems,
            "dirs": dir_sizes,
            "scan_time": datetime.now(UTC).isoformat(),
            "cached": False,
        }
        return result
    except Exception as e:
        return {"error": str(e)}


def scan_junk():
    """Walk JUNK_SCAN_DIRS and return list of junk files/dirs with metadata."""
    found = []
    for base in JUNK_SCAN_DIRS:
        if not os.path.isdir(base):
            continue
        for root, dirs, files in os.walk(base):
            for name in files:
                if any(fnmatch.fnmatch(name, p) for p in JUNK_PATTERNS):
                    path = os.path.join(root, name)
                    try:
                        size = os.path.getsize(path)
                    except OSError:
                        size = 0
                    found.append({"path": path, "name": name, "size": size})
            prune = [d for d in dirs if any(fnmatch.fnmatch(d, p) for p in JUNK_PATTERNS)]
            for name in prune:
                path = os.path.join(root, name)
                found.append({"path": path, "name": name, "size": 0, "is_dir": True})
                dirs.remove(name)
    return found


