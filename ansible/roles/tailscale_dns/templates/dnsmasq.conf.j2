# dnsmasq configuration for Tailscale DNS
# Managed by Ansible — do not edit manually

# Don't read /etc/resolv.conf or /etc/hosts
no-resolv
no-hosts

# Resolve every internal domain (*.example, *.example.org) to the Pi's Tailscale IP.
# Driven by homelab_internal_domains so VPN parity tracks the LAN AdGuard wildcards.
{% for d in homelab_internal_domains | default([tailscale_dns_local_domain]) %}
address=/{{ d }}/{{ tailscale_dns_ip }}
{% endfor %}

# Upstream DNS servers (for everything else)
{% for server in tailscale_dns_upstream %}
server={{ server }}
{% endfor %}

# Cache settings
cache-size=1000
