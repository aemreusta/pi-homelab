#!/bin/bash
# /usr/local/bin/restore-drill-nudge.sh
# Quarterly reminder to run a backup-restore drill. Cron fires on the 1st
# Monday of Jan/Apr/Jul/Oct at 10:00; cron itself doesn't support
# "1st Monday of month", so the wrapper exits early on the other Mondays.
# References runbook 028. Sprint 017 Story 6.
#
# Managed by Ansible (common role) — do not edit manually.

set -uo pipefail

NTFY_URL="{{ ntfy_external_topic_url }}"
RUNBOOK_URL="{{ restore_drill_runbook_url | default('https://github.com/aemreusta/raspi-homelab/blob/master/docs/runbooks/028-backup-restore.md') }}"

# shellcheck source=/dev/null
source /usr/local/lib/homelab/alert-lib.sh

# Witness line — proves the quarterly cron is wired even on months
# where the date guard short-circuits.
alert_event "restore-drill-nudge" run ok "month=$(date +%m)" "dom=$(date +%d)"

# Cron schedule is `0 10 1-7 1,4,7,10 1` (1st-7th day of quarter months,
# but only if it's a Monday). The day-of-week guard is on cron; the
# day-of-month range 1-7 ensures we hit the FIRST Monday only.
DOM=$(date +%d)
if [ "$DOM" -gt 7 ]; then
    alert_event "restore-drill-nudge" skip ok "reason=not-first-week"
    exit 0
fi

QUARTER=$(( ($(date +%-m) - 1) / 3 + 1 ))

ntfy_send "restore-drill-nudge" \
    -H "Title: Q${QUARTER} restore drill due" \
    -H "Priority: default" \
    -H "Tags: floppy_disk,calendar" \
    -H "Markdown: yes" \
    -H "Actions: view, Open runbook, ${RUNBOOK_URL}, clear=true" \
    -d "Quarterly restore-drill nudge — run the next drill this month.

**Why:** backup runbooks rot fast; runbook 028 says 'restore must be tested,
not assumed.' Last drills are logged in the runbook itself.

**How:** follow runbook 028 §Drill procedure. Budget ~30 min." \
    "$NTFY_URL" || true
