---
# Authelia configuration — managed by Ansible (do not edit on the host).
# Rendered from roles/authelia/templates/configuration.yml.j2 and validated with
# `authelia validate-config` in deploy.yml BEFORE the container (re)starts.
theme: 'dark'

server:
  address: 'tcp://:9091'
  # Raise the read/write/idle timeouts above Authelia's 6s/6s/30s defaults. On a
  # disk-saturated Pi (root fs ~95%) the portal SPA at `/` can take >6s to serve
  # and idle keepalive connections outlive 30s, both of which the default config
  # logs as `status_code=408 … i/o timeout` errors (2026-07-22). Guarded by
  # tests/test_authelia_config.py; validated at deploy by `authelia validate-config`.
  timeouts:
    read: '30s'
    write: '30s'
    idle: '60s'

log:
  level: '{{ authelia_log_level }}'
  format: 'text'

# Prometheus metrics for the vmagent `authelia` job (AutheliaDown alert).
telemetry:
  metrics:
    enabled: true
    address: 'tcp://:{{ authelia_metrics_port }}'

# 1FA only (operator directive 2026-07-14) — TOTP disabled.
totp:
  disable: true

identity_validation:
  reset_password:
    jwt_secret: '{{ authelia_jwt_secret }}'

authentication_backend:
  file:
    path: '/config/users_database.yml'
    password:
      algorithm: 'argon2'

access_control:
  default_policy: 'deny'
  rules:
{% for svc in authelia_forward_auth_services %}
    - domain:
{% for base in authelia_domains %}
        - '{{ svc }}.{{ base }}'
{% endfor %}
      policy: 'one_factor'
{% endfor %}

session:
  name: 'authelia_session'
  secret: '{{ authelia_session_secret }}'
  cookies:
{# Only domains with a period can hold a session cookie (browsers/Authelia
   reject single-label domains like bare `example`). The internal TLD is
   `example.internal` (clean cut 2026-07-15), a valid 2-label cookie parent. #}
{% for base in authelia_domains if '.' in base %}
    - domain: '{{ base }}'
      authelia_url: 'https://auth.{{ base }}'
      default_redirection_url: 'https://{{ authelia_default_redirect_service }}.{{ base }}'
{% endfor %}

regulation:
  max_retries: 4
  find_time: '2 minutes'
  ban_time: '5 minutes'

storage:
  encryption_key: '{{ authelia_storage_encryption_key }}'
  postgres:
    address: 'tcp://{{ authelia_db_host }}:{{ authelia_db_port }}'
    database: '{{ authelia_db_name }}'
    username: '{{ authelia_db_user }}'
    password: '{{ authelia_db_password }}'

notifier:
  # Password-reset / notifications land in a file (no SMTP in this homelab).
  filesystem:
    filename: '/config/notification.txt'
{% if authelia_oidc_clients | length > 0 %}

identity_providers:
  oidc:
    hmac_secret: '{{ authelia_oidc_hmac_secret }}'
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
{{ authelia_oidc_issuer_private_key | indent(width=10, first=True) }}
    clients:
{% for c in authelia_oidc_clients %}
      - client_id: '{{ c.id }}'
        client_name: '{{ c.name }}'
        client_secret: '{{ c.secret_hash }}'
        public: false
        authorization_policy: 'one_factor'
        require_pkce: false
        redirect_uris:
{% for u in c.redirect_uris %}
          - '{{ u }}'
{% endfor %}
        scopes:
          - 'openid'
          - 'profile'
          - 'groups'
          - 'email'
        userinfo_signed_response_alg: 'none'
        token_endpoint_auth_method: 'client_secret_basic'
{% endfor %}
{% endif %}
