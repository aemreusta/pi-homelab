---
# Grafana — dashboards & explore UI for VictoriaMetrics + VictoriaLogs
# Anonymous access disabled; admin user gated via vault password.
# Bridge network access to VL/VM via container DNS names.

services:
  grafana:
    image: {{ grafana_image }}
    container_name: grafana
    restart: unless-stopped
    init: true
    mem_limit: {{ grafana_mem_limit }}
    pids_limit: {{ grafana_pids_limit }}
    read_only: {{ grafana_read_only | lower }}
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size={{ grafana_tmpfs_size }}
    user: "{{ grafana_container_uid }}"
    security_opt:
      - no-new-privileges:true
    cap_drop:
{% for cap in grafana_cap_drop %}
      - {{ cap }}
{% endfor %}
{% if grafana_cap_add | length > 0 %}
    cap_add:
{% for cap in grafana_cap_add %}
      - {{ cap }}
{% endfor %}
{% endif %}
    labels:
{% for k, v in grafana_oci_labels.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    networks:
      - {{ grafana_network }}
    ports:
      - "{{ grafana_port }}:3000"
    volumes:
      - {{ grafana_data_dir }}:/var/lib/grafana
      - {{ grafana_provisioning_dir }}:/etc/grafana/provisioning:ro
      - {{ grafana_dashboards_dir }}:/var/lib/grafana/dashboards:ro
      # Internal CA — lets Grafana VERIFY Traefik's self-signed leaf on the
      # OIDC token-exchange back-channel (GF_AUTH_GENERIC_OAUTH_TLS_CLIENT_CA).
      - {{ grafana_internal_ca_src }}:{{ grafana_internal_ca_path }}:ro
    environment:
      - TZ={{ grafana_tz }}
      - GF_LOG_LEVEL={{ grafana_log_level }}
      - GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
      - GF_USERS_ALLOW_SIGN_UP=false
      - GF_AUTH_ANONYMOUS_ENABLED=false
      # ── SSO via Authelia (OIDC) ──────────────────────────────────────
      # One login for the homelab. The local admin above stays enabled as
      # BREAK-GLASS: if Authelia/Postgres is down, log in at
      # https://grafana.<domain>/login with GF_SECURITY_ADMIN_*.
      # ROOT_URL is required — Grafana builds the OAuth redirect_uri from it,
      # and it must match the redirect_uris registered in the authelia role.
      - GF_SERVER_ROOT_URL=https://grafana.{{ homelab_internal_domains[0] }}
      - GF_AUTH_GENERIC_OAUTH_ENABLED=true
      - GF_AUTH_GENERIC_OAUTH_NAME=Authelia
      - GF_AUTH_GENERIC_OAUTH_CLIENT_ID=grafana
      - GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET={{ grafana_oidc_client_secret }}
      - GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email groups
      - GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.{{ homelab_internal_domains[0] }}/api/oidc/authorization
      - GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.{{ homelab_internal_domains[0] }}/api/oidc/token
      - GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.{{ homelab_internal_domains[0] }}/api/oidc/userinfo
      - GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
      # The code→token back-channel is Grafana → https://auth.<domain> via
      # Traefik, whose leaf is signed by the SELF-SIGNED internal CA. Point
      # Grafana at that CA so it VERIFIES the chain properly — do NOT use
      # GF_AUTH_GENERIC_OAUTH_TLS_SKIP_VERIFY_INSECURE, which would disable
      # verification for the token exchange entirely. Without either, OIDC login
      # fails at token exchange with an x509 error (the same internal-CA TLS
      # class as the Label Studio ML-backend fetch).
      - GF_AUTH_GENERIC_OAUTH_TLS_CLIENT_CA={{ grafana_internal_ca_path }}
      # Map the Authelia `admins` group → Grafana Admin; everyone else Viewer.
      - GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'admins') && 'Admin' || 'Viewer'
      - GF_ANALYTICS_REPORTING_ENABLED=false
      - GF_ANALYTICS_CHECK_FOR_UPDATES=false
      # GF_PLUGINS_PREINSTALL_SYNC blocks startup until plugins finish
      # installing — guarantees the datasource provisioner sees the new
      # plugin type on the same boot. (Replaces deprecated GF_INSTALL_PLUGINS.)
      - GF_PLUGINS_PREINSTALL_SYNC={{ grafana_plugins }}
      # The VictoriaLogs datasource plugin is signed by VictoriaMetrics rather
      # than Grafana Labs; whitelist it explicitly.
      - GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS={{ grafana_plugins }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --spider http://localhost:3000/api/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

networks:
  {{ grafana_network }}:
    external: true
