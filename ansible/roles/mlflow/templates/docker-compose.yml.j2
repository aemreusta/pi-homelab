---
# MLflow tracking server — experiment tracking + model registry (PRD-004).
# Built from files/Dockerfile (uv image with psycopg2 + boto3). Managed by
# Ansible — do not edit manually.

services:
  mlflow:
    build: .
    image: {{ mlflow_image }}
    container_name: mlflow
    restart: unless-stopped
    init: true
    user: "{{ mlflow_puid }}:{{ mlflow_pgid }}"
    mem_limit: {{ mlflow_mem_limit }}
    pids_limit: {{ mlflow_pids_limit }}
    security_opt:
      - no-new-privileges:true
    cap_drop:
{% for c in mlflow_cap_drop %}
      - {{ c }}
{% endfor %}
    labels:
{% for k, v in mlflow_oci_labels.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    # --serve-artifacts (proxy mode): clients log/fetch artifacts through MLflow,
    # so only this server holds S3 creds. --backend-store-uri is NOT passed on
    # the command line — it is injected as MLFLOW_BACKEND_STORE_URI so the DB
    # password doesn't appear in `docker inspect`, `ps aux`, or startup logs.
    command:
      - mlflow
      - server
      - --serve-artifacts
      - --artifacts-destination
      - s3://{{ mlflow_artifact_bucket }}
      - --host
      - 0.0.0.0
      - --port
      - "5000"
      - --workers
      - "{{ mlflow_workers }}"
      - --allowed-hosts
      - "{{ mlflow_allowed_hosts }}"
      - --expose-prometheus
      - "{{ mlflow_prometheus_dir }}"
    environment:
      - TZ={{ mlflow_tz }}
      # DB URI as env var — password never enters the process command line.
      - MLFLOW_BACKEND_STORE_URI=postgresql://{{ mlflow_db_user }}:{{ mlflow_db_password }}@{{ mlflow_db_host }}:{{ mlflow_db_port }}/{{ mlflow_db_name }}
      # Scoped MinIO service account (bucket-limited) — NOT root.
      - MLFLOW_S3_ENDPOINT_URL={{ mlflow_s3_endpoint }}
      - AWS_ACCESS_KEY_ID={{ mlflow_minio_access_key }}
      - AWS_SECRET_ACCESS_KEY={{ mlflow_minio_secret_key }}
      # Server-side job execution (huey consumer pool). OFF here — see the
      # variable's definition in defaults/main.yml for the measurement.
      - MLFLOW_SERVER_ENABLE_JOB_EXECUTION={{ mlflow_enable_job_execution | lower }}
    ports:
      - "{{ mlflow_port }}:5000"
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      # slim image has python but no curl — probe /health with urllib.
      test:
        - CMD
        - python
        - -c
        - "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:5000/health').status==200 else 1)"
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 40s
    networks:
      - mlstack_net

networks:
  mlstack_net:
    # Created by the postgresql role; declared external so MLflow can resolve
    # postgresql:5432 over it. Deploy postgresql before mlflow.
    external: true
