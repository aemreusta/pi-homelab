---
# Beszel — lightweight server monitoring with Docker support
# https://beszel.dev
# Both hub and agent use host networking so hub can reach agent on 127.0.0.1
# S.M.A.R.T. not available: SanDisk Portable SSD USB bridge does not expose SMART data

services:
  beszel:
    image: henrygd/beszel:latest
    container_name: beszel
    restart: unless-stopped
    init: true
    mem_limit: {{ beszel_mem_limit }}
    pids_limit: {{ beszel_pids_limit }}
    security_opt:
      - no-new-privileges:true
    cap_drop:
{% for cap in beszel_cap_drop %}
      - {{ cap }}
{% endfor %}
{% if beszel_cap_add | length > 0 %}
    cap_add:
{% for cap in beszel_cap_add %}
      - {{ cap }}
{% endfor %}
{% endif %}
    labels:
{% for k, v in beszel_oci_labels.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    network_mode: host
    volumes:
      - {{ beszel_data_dir }}:/beszel_data
    environment:
      - TZ={{ beszel_tz }}
      - AUTO_LOGIN={{ beszel_admin_email }}
      - SHARE_ALL_SYSTEMS=true
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "/beszel", "health", "--url", "http://localhost:8090"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  beszel-agent:
    image: henrygd/beszel-agent:latest
    container_name: beszel-agent
    restart: unless-stopped
    init: true
    mem_limit: {{ beszel_agent_mem_limit }}
    pids_limit: {{ beszel_agent_pids_limit }}
    security_opt:
      - no-new-privileges:true
    cap_drop:
{% for cap in beszel_cap_drop %}
      - {{ cap }}
{% endfor %}
{% if beszel_cap_add | length > 0 %}
    cap_add:
{% for cap in beszel_cap_add %}
      - {{ cap }}
{% endfor %}
{% endif %}
    labels:
{% for k, v in beszel_agent_oci_labels.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    network_mode: host
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - {{ beszel_agent_data_dir }}:/var/lib/beszel-agent
{% for fs in beszel_extra_filesystems | default([]) %}
      # Extra disk: the marker dir lives ON the target filesystem, so this
      # keeps working across device renaming. See beszel/defaults/main.yml.
      - {{ fs.host_path }}:/extra-filesystems/{{ fs.name }}:ro
{% endfor %}
    environment:
      - TZ={{ beszel_tz }}
      - LISTEN={{ beszel_agent_port }}
{% if vault_beszel_agent_key is defined and vault_beszel_agent_key | length > 0 %}
      - KEY={{ vault_beszel_agent_key }}
{% endif %}
      - FILESYSTEM={{ beszel_root_filesystem }}
{% if beszel_extra_filesystems_env | default('') | length > 0 %}
      - EXTRA_FILESYSTEMS={{ beszel_extra_filesystems_env }}
{% endif %}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    healthcheck:
      test: ["CMD", "/agent", "health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
