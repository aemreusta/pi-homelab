/* Make the top bar and service cards opaque so text wins over the background
   photo. homepage's card element is `div.service-card` (the old `li[data-testid]`
   selector matched nothing in v1.13.1 — readability was silently broken).
   IMPORTANT: tint ONLY the outer header box `#information-widgets`, NOT the broad
   `div[id*="information-widget"]` — that also matched the nested
   `#information-widgets-right` (datetime/weather) cluster, painting a SECOND dark
   box inside the header (double opacity = a darker rectangle overlapping the
   header on wide screens). One box = one tint. */
#information-widgets,
.service-card {
  background-color: rgba(15, 23, 42, 0.92) !important;
}

/* Group headings sit directly on the photo — shadow keeps them legible over
   bright areas (e.g. water). */
#layout-groups > div.services-group > h2 {
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
}

/* Section heading separator */
section > div:first-child button {
  border-bottom: 1px solid rgba(255,255,255,0.08);
  padding-bottom: 6px;
  width: 100%;
}

/* ── Versions + Changelog drawer (built by custom.js) ──────────────────────
   Themed to match the dashboard: same slate glass as .service-card above, blue
   accent for the version badge/headings. Right-side slide-in; collapsible per
   release. All ids/classes are #cl-* so nothing here touches homepage's own DOM. */
#cl-fab {
  position: fixed; right: 16px; bottom: 16px; z-index: 9998;
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 13px; border-radius: 999px;
  background-color: rgba(15, 23, 42, 0.92);
  color: #e2e8f0; font: 500 13px/1 ui-sans-serif, system-ui, sans-serif;
  border: 1px solid rgba(255, 255, 255, 0.12); cursor: pointer;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4); backdrop-filter: blur(6px);
  transition: background-color .15s ease, transform .15s ease;
}
#cl-fab:hover { background-color: rgba(30, 41, 59, 0.98); transform: translateY(-1px); }
#cl-fab .cl-badge {
  background-color: #3b82f6; color: #fff; border-radius: 999px;
  padding: 1px 7px; font-size: 11px; font-weight: 600;
}
#cl-backdrop {
  position: fixed; inset: 0; z-index: 9998;
  background-color: rgba(0, 0, 0, 0.5);
  opacity: 0; pointer-events: none; transition: opacity .2s ease;
}
#cl-drawer {
  position: fixed; top: 0; right: 0; height: 100%; z-index: 9999;
  width: min(440px, 92vw);
  display: flex; flex-direction: column;
  background-color: rgba(15, 23, 42, 0.98); color: #e2e8f0;
  border-left: 1px solid rgba(255, 255, 255, 0.10);
  box-shadow: -8px 0 30px rgba(0, 0, 0, 0.5);
  transform: translateX(100%); transition: transform .25s ease;
}
html.cl-open #cl-drawer { transform: translateX(0); }
html.cl-open #cl-backdrop { opacity: 1; pointer-events: auto; }
#cl-drawer > header {
  flex: 0 0 auto; display: flex; align-items: center; justify-content: space-between;
  gap: 8px; padding: 14px 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
#cl-drawer > header h3 { margin: 0; font-size: 14px; font-weight: 600; }
#cl-close {
  background: none; border: none; color: #94a3b8; font-size: 18px; line-height: 1;
  cursor: pointer; padding: 3px 7px; border-radius: 6px;
}
#cl-close:hover { background-color: rgba(255, 255, 255, 0.08); color: #e2e8f0; }
#cl-body { flex: 1 1 auto; overflow-y: auto; padding: 4px 8px 28px; }
.cl-ver { border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
.cl-ver > .cl-ver-head {
  width: 100%; text-align: left; background: none; border: none; cursor: pointer;
  color: #e2e8f0; padding: 11px 8px; font-size: 14px;
  display: flex; align-items: baseline; gap: 8px;
}
.cl-ver > .cl-ver-head:hover { background-color: rgba(255, 255, 255, 0.04); }
.cl-ver-head .cl-caret { color: #64748b; font-size: 11px; transition: transform .15s ease; }
.cl-ver.open .cl-ver-head .cl-caret { transform: rotate(90deg); }
.cl-ver-head .cl-ver-name { font-weight: 600; }
.cl-ver-head .cl-ver-date { margin-left: auto; color: #64748b; font-size: 12px; white-space: nowrap; }
.cl-ver-content { display: none; padding: 2px 10px 12px 22px; font-size: 13px; line-height: 1.55; color: #cbd5e1; }
.cl-ver.open .cl-ver-content { display: block; }
.cl-ver-content h4 { margin: 11px 0 4px; font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: #93c5fd; }
.cl-ver-content ul { margin: 4px 0; padding-left: 4px; list-style: none; }
.cl-ver-content li { position: relative; margin: 6px 0; padding-left: 15px; }
.cl-ver-content li::before { content: "▪"; position: absolute; left: 2px; color: #475569; }
.cl-ver-content p { margin: 5px 0; }
/* Progressive disclosure: bold lead is the scannable summary; detail hides until
   the bullet is clicked. Keeps long changelog entries from being walls of text. */
.cl-li { cursor: pointer; }
.cl-li .cl-lead { color: #e2e8f0; font-weight: 600; }
.cl-li:hover .cl-lead { color: #fff; }
.cl-li .cl-detail { display: none; color: #94a3b8; }
.cl-li.cl-expanded .cl-detail { display: inline; }
.cl-li::after { content: " …"; color: #64748b; font-weight: 600; }
.cl-li.cl-expanded::after { content: ""; }
.cl-ver-content code { background-color: rgba(148, 163, 184, 0.16); padding: 1px 4px; border-radius: 4px; font-size: 12px; }
.cl-ver-content strong { color: #f1f5f9; }
.cl-ver-content a { color: #60a5fa; text-decoration: none; }
.cl-ver-content a:hover { text-decoration: underline; }
@media (max-width: 640px) { #cl-fab { right: 12px; bottom: 12px; } }
