---
- Media:
    - Jellyfin:
        icon: jellyfin.png
        href: https://jellyfin.{{ homelab_internal_domains[0] }}
        description: Media Server
        server: my-docker
        container: jellyfin
        widget:
            type: jellyfin
            url: http://{{ adguard_host_ip | default(ansible_facts['default_ipv4']['address']) }}:8096
            key: "{{ homepage_jellyfin_api_key }}"
            enableBlocks: true
            enableNowPlaying: true
