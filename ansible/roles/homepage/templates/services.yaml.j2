            url: http://{{ adguard_host_ip | default(ansible_facts['default_ipv4']['address']) }}:8180
    - Tailscale:
        icon: tailscale.png
        href: https://login.tailscale.com/admin/machines
        description: VPN Mesh
    - ntfy:
        icon: ntfy.png
        href: https://{{ ntfy_hostname | default('ntfy.' ~ homelab_internal_domains[0]) }}
