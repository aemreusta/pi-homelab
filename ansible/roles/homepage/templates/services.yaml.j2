        container: ntfy

- Infrastructure:
    - Portainer:
        icon: portainer.png
        href: https://portainer.{{ homelab_internal_domains[0] }}
        description: Containers
        server: my-docker
        container: portainer
    - FileBrowser:
        icon: filebrowser.png
        href: https://filebrowser.{{ homelab_internal_domains[0] }}
        description: File Manager
        server: my-docker
        container: filebrowser
    - Watchtower:
        icon: watchtower.png
        description: Auto Updates
        server: my-docker
        container: watchtower
    - Control API:
        icon: mdi-remote
        # Link card only. The customapi widget was removed: the API binds
        # 127.0.0.1 by design (defense-in-depth), so the LAN-IP widget always
        # ETIMEDOUT (red card + stalled proxy). Routing it via Traefik would
        # fail the self-signed homelab CA inside the container — not worth it.
        # DEFERRED (conscious): the token is rendered into the href as a query
        # param (browser history/referrer/log exposure). Out of scope for this
        # dashboard pass; track separately if it matters.
        href: "https://control.{{ homelab_internal_domains[0] }}/?token={{ homepage_control_token }}"
        description: Shutdown · Restart · Update
    - byparr:
        icon: mdi-cloud-lock-outline
        # byparr moved to the Mac worker 2026-07-13 (192.0.2.102) — it can't
        # solve Cloudflare on the Pi 4B. No docker status widget: the Mac's
        # Docker socket isn't exposed to the Pi's Homepage. See mac-worker/.
        href: http://192.0.2.102:8191/docs
        description: Cloudflare bypass (Mac worker)
    - Zot Registry:
        # Local OCI registry for homelab-built images.
        # Link card → browser UI over Traefik TLS. Push is raspberrypi.local:5050
        # (plain HTTP + insecure-registries), NOT this route. No native Homepage
        # widget for zot; container stats come from the my-docker socket. A
        # customapi /v2/_catalog widget is deliberately skipped — it needs
        # basic-auth + the repo-count mapping is the same brittleness the
        # Control API note above warns about.
        icon: mdi-package-variant-closed
        href: https://registry.{{ homelab_internal_domains[0] }}
        description: OCI registry (homelab images)
        server: my-docker
        container: zot

